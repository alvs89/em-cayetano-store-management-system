NODE_ENV=development
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
# Required in production. Use the exact deployed frontend origin, no trailing slash.
# Multiple origins may be comma-separated for staging + production.
CORS_ORIGIN=
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password
SYSTEM_LOG_RETENTION_DAYS=30
ADMIN_RESET_PASSWORD=replace-with-a-temporary-admin-reset-password

# Required only when using Maintenance backup/restore on a host that does not
# provide PostgreSQL command-line tools on PATH.
PG_DUMP_PATH=
PSQL_PATH=
